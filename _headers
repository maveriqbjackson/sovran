# ── Long-lived caching for immutable assets ──
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/wordlist.txt
  Cache-Control: public, max-age=31536000, immutable

/sv-crypto.js
  Cache-Control: public, max-age=86400

/jszip.min.js
  Cache-Control: public, max-age=31536000, immutable

/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/api/admin
  X-Robots-Tag: noindex, nofollow

# ── The Map is the only page permitted to reach outside this domain,
#    and only to the public OpenStreetMap query service. Every other page
#    stays locked to 'self'. The exception is narrow and deliberate.
/map
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://overpass-api.de; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

/map.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://overpass-api.de; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# ── Security headers, site-wide ──
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # Because every asset is self-hosted, we can forbid all outside loading
  # outright. If anything were ever injected into a page here, the browser
  # would refuse to fetch it. Architecture, not promise.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
