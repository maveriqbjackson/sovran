# ── Long-lived caching for immutable assets ──
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=604800

/og-square.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/wordlist.txt
  Cache-Control: public, max-age=31536000, immutable

/sv-crypto.js
  Cache-Control: public, max-age=86400

/jszip.min.js
  Cache-Control: public, max-age=31536000, immutable

/mapdata/*
  Cache-Control: public, max-age=86400
  Content-Type: application/json

# ── Admin is never indexed and never cached ──
/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://overpass-api.de https://overpass.kumi.systems; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

/admin.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://overpass-api.de https://overpass.kumi.systems; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

/api/admin
  X-Robots-Tag: noindex, nofollow

# ── Security headers, site-wide.
#    NOTE: Content-Security-Policy is deliberately NOT set here. When a browser
#    receives two CSP headers it enforces the INTERSECTION of both, so a policy
#    here would silently override every per-page exception below. CSP is
#    therefore declared once per path, explicitly.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# ── The Map: the ONLY path allowed to reach outside this domain, and only to
#    the public OpenStreetMap query service. Two mirrors, both read-only.
/map
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://overpass-api.de https://overpass.kumi.systems; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

/map.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://overpass-api.de https://overpass.kumi.systems; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# ── Everything else: locked to this domain. Declared per path, because a
#    wildcard rule would intersect with the Map exception above and break it.
/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

